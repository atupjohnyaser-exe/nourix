# Copy this file to .env and fill in your own values. Never commit the real .env file.
APP_NAME=NouriX
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Local database (MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nourix
DB_USERNAME=root
DB_PASSWORD=
# On Render use PostgreSQL instead: DB_CONNECTION=pgsql and DB_URL=(the Internal Database URL)
# DB_URL=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Password reset emails. "log" writes the link to storage/logs/laravel.log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Address of the React website. Used for CORS and for links that open the website.
FRONTEND_URL=http://localhost:5173

# PayMongo TEST keys only (dashboard.paymongo.com, test mode). The server refuses live keys.
PAYMONGO_SECRET_KEY=sk_test_your_test_key_here
PAYMONGO_WEBHOOK_SECRET=
